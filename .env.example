# Required
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Truth Social handle to monitor
TRUTH_SOCIAL_HANDLE=realDonaldTrump

# IBKR — 4002 = IB Gateway paper, 7497 = TWS paper, 7496 = TWS live
IBKR_HOST=127.0.0.1
IBKR_PORT=4002
IBKR_CLIENT_ID=42

# News polling interval (seconds)
NEWS_POLL_INTERVAL_SECONDS=30

# Classifier — set LLM_PROVIDER and LLM_API_KEY to enable LLM fallback
LLM_PROVIDER=none
LLM_API_KEY=

# Strategy thresholds (defaults shown — all optional)
SPIKE_WINDOW_SECONDS=120
PULLBACK_WINDOW_SECONDS=300
TOTAL_WINDOW_SECONDS=600
PULLBACK_K=0.5
ATR_BARS=12
K_STATIC=0.10
TARGET_RR=1.5

LOG_LEVEL=INFO
